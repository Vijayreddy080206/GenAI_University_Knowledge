{
  "info": {
    "name": "GenAI University Knowledge Assistant - Production API Suite",
    "_postman_id": "81e7661c-c639-48cb-907e-b5a5778bb1c9",
    "description": "Production End-to-End API Verification Collection for NIIT University Capstone Project II (Team-20). Covers Health probes, Google/SSO/Local Auth, Conversational RAG queries, Ingestion, Feedback, and Admin Analytics.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
