  "item": [
    {
      "name": "01. Liveness Probe",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/healthz",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "healthz"
          ]
        },
        "description": "Kubernetes Liveness probe returning 2/2 replica status for all microservices."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Response time < 5000ms', function () { pm.expect(pm.response.responseTime).to.be.below(5000); });",
              "pm.test('Service status is UP', function () { var j = pm.response.json(); pm.expect(j.status).to.eql('UP'); });",
              "pm.test('Kubernetes probes healthy', function () { var j = pm.response.json(); pm.expect(j.kubernetes_probes).to.be.an('object'); });"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
