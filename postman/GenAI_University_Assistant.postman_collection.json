    {
      "name": "05. Student Local Login (Auto-extracts JWT Token)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"vijay.reddy23@st.niituniversity.in\",\n  \"password\": \"student123\",\n  \"is_sso\": false\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/auth/login",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        },
        "description": "Authenticates student credentials and automatically stores JWT token in environment."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('JWT token returned and saved to environment', function () {",
              "    var j = pm.response.json();",
              "    pm.expect(j.token).to.be.a('string');",
              "    pm.environment.set('auth_token', j.token);",
              "    pm.environment.set('student_token', j.token);",
              "});",
              "pm.test('User role is STUDENT', function () { var j = pm.response.json(); pm.expect(j.user.role).to.eql('STUDENT'); });"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
