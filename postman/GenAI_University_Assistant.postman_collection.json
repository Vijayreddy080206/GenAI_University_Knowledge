    {
      "name": "08. Ask Grounded RAG Query (Fees & Citations)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{auth_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"query_text\": \"When is the last date to pay the semester fees and what is the late fine?\",\n  \"session_id\": {{active_session_id}},\n  \"department_filter\": \"Accounts\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/chat/query",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "chat",
            "query"
          ]
        },
        "description": "Submits query to ChromaDB vector search and LLM orchestrator. Checks citations and response time."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Response time under 5000ms (NFR-PERF-01)', function () { pm.expect(pm.response.responseTime).to.be.below(5000); });",
              "pm.test('RAG status is ANSWERED', function () { var j = pm.response.json(); pm.expect(j.status).to.eql('ANSWERED'); });",
              "pm.test('Contains grounded citation pills [1]', function () {",
              "    var j = pm.response.json();",
              "    pm.expect(j.citations).to.be.an('array');",
              "    pm.expect(j.citations.length).to.be.above(0);",
              "    pm.expect(j.citations[0].rank).to.eql(1);",
              "    pm.environment.set('latest_response_id', j.response_id);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
