// ==============================================================================
// NIIT University - Generative AI-Based University Knowledge Assistant
// Jenkins Windows CI/CD Production Pipeline (Capstone Project II - Team-20)
// Automated Stages: SCM -> Dependencies -> Unit Tests -> Docker -> Selenium E2E -> Reporting
// ==============================================================================

pipeline {
    agent any

    environment {
        PROJECT_DIR = 'C:\\Users\\Vijay\\Desktop\\GenAI_University_Knowledge_Assistant_Full_Project'
        PYTHON_PATH = 'C:\\Users\\Vijay\\AppData\\Local\\Programs\\Python\\Python311'
        HEADLESS = 'true'
        APP_URL = 'https://localhost'
        RENDER_URL = 'https://genai-university-knowledge.onrender.com'
        VERCEL_URL = 'https://genaiuniversityknowledge-frontend.vercel.app'
    }

    stages {
        stage('1. SCM Checkout & Safe Directory') {
            steps {
                echo '=== Stage 1: Configuring Safe Directory & Checking Git Repository State ==='
                bat 'git config --global --add safe.directory *'
                dir("${PROJECT_DIR}") {
                    bat 'git status'
                    bat 'git log -1 --oneline'
                }
            }
        }

        stage('2. Python Dependencies & Environment') {
            steps {
                echo '=== Stage 2: Verifying Python Runtime & Installing Test Requirements ==='
                dir("${PROJECT_DIR}") {
                    bat "\"${PYTHON_PATH}\\python.exe\" --version"
                    bat "\"${PYTHON_PATH}\\python.exe\" -m pip install -r backend/requirements.txt pytest pytest-html selenium"
                }
            }
        }

        stage('3. Automated Unit & Integration Tests') {
            steps {
                echo '=== Stage 3: Executing 18 SRS/SDD Automated Verification Tests ==='
                dir("${PROJECT_DIR}") {
                    bat "set PYTHONPATH=backend&& \"${PYTHON_PATH}\\python.exe\" -m pytest backend/tests/ -v --junitxml=reports/unit_junit.xml --html=reports/unit_test_report.html --self-contained-html"
                }
            }
        }

        stage('4. Docker Microservices Health & Spec Check') {
            steps {
                echo '=== Stage 4: Verifying Docker Compose & 3-Tier Container Health ==='
                dir("${PROJECT_DIR}") {
                    bat 'docker compose config'
                    bat 'curl.exe -k -s https://localhost/healthz || exit 0'
                    bat 'curl.exe -s http://localhost:4000/gateway/health || exit 0'
                }
            }
        }

        stage('5. Headless Selenium E2E Journey Tests') {
            steps {
                echo '=== Stage 5: Executing Headless Selenium 4 E2E Test Suite (6 User Journeys) ==='
                dir("${PROJECT_DIR}") {
                    bat "set HEADLESS=true&& set APP_URL=https://localhost&& \"${PYTHON_PATH}\\python.exe\" -m pytest tests/selenium/test_e2e_ui.py -v --junitxml=reports/selenium_junit.xml --html=reports/selenium_report.html --self-contained-html"
                }
            }
        }

        stage('6. Cloud Deployment & Live Smoke Check (Render + Vercel)') {
            steps {
                echo '=== Stage 6: Triggering Cloud Deploy Hooks & Verifying Live Render + Vercel ==='
                bat '''
                    if defined RENDER_DEPLOY_HOOK (
                        echo Triggering Render Deploy Hook...
                        curl.exe -s -X POST "%RENDER_DEPLOY_HOOK%"
                    ) else (
                        echo RENDER_DEPLOY_HOOK not set - skipping manual hook ^(Render auto-deploys from GitHub main^)
                    )
                    if defined VERCEL_DEPLOY_HOOK (
                        echo Triggering Vercel Deploy Hook...
                        curl.exe -s -X POST "%VERCEL_DEPLOY_HOOK%"
                    ) else (
                        echo VERCEL_DEPLOY_HOOK not set - skipping manual hook ^(Vercel auto-deploys from GitHub main^)
                    )
                    echo Checking live Render Backend health...
                    curl.exe -s -f "%RENDER_URL%/healthz" || exit /b 1
                    echo Checking live Vercel Frontend -> Render API proxy...
                    curl.exe -s -f "%VERCEL_URL%/api/config" || exit /b 1
                '''
            }
        }
    }

    post {
        always {
            echo '=== Post Execution: Archiving Test Results & Screenshots ==='
            dir("${PROJECT_DIR}") {
                junit allowEmptyResults: true, testResults: 'reports/*_junit.xml'
                archiveArtifacts allowEmptyArchive: true, artifacts: 'reports/*.html, reports/screenshots/*.png'
            }
        }
        success {
            echo '====================================================='
            echo 'SUCCESS: GenAI University Assistant CI/CD Build PASSED!'
            echo 'Unit Tests: 18/18 Verified. Selenium E2E: 6/6 Verified.'
            echo '====================================================='
        }
        failure {
            echo '====================================================='
            echo 'FAILURE: One or more pipeline verification stages failed.'
            echo '====================================================='
        }
    }
}
